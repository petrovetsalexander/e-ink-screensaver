<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:scaleType="centerInside"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- ═══════ Service ═══════ -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_off"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/enable_screensaver"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <!-- ═══════ Permissions ═══════ -->
        <LinearLayout
            android:id="@+id/permissionSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permissions_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <!-- One block per permission: the line says what it is and whether
                 it is granted, the ? opens the explanation, the button asks for
                 it. The explanations used to be pasted into one paragraph above
                 the buttons, which made the section a wall of text nobody read
                 and left no way to tell which hint belonged to which button. -->

            <!-- Notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/permNotifLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/checking"
                    android:textSize="15sp"
                    android:textColor="#000000" />

                <ImageButton
                    android:id="@+id/btnWhyNotif"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/why_permission" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantNotification"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/grant_notifications"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Return to sleep (accessibility) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/permA11yLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/checking"
                    android:textSize="15sp"
                    android:textColor="#000000" />

                <ImageButton
                    android:id="@+id/btnWhyA11y"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/why_permission" />
            </LinearLayout>

            <TextView
                android:id="@+id/a11yLostWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/a11y_lost_warning"
                android:textSize="13sp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnGrantA11y"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/grant_a11y"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Notification access -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/permNotifAccessLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/checking"
                    android:textSize="15sp"
                    android:textColor="#000000" />

                <ImageButton
                    android:id="@+id/btnWhyNotifAccess"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/why_permission" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantNotifAccess"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/grant_notif_access"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Draw over other apps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/permOverlayLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/checking"
                    android:textSize="15sp"
                    android:textColor="#000000" />

                <ImageButton
                    android:id="@+id/btnWhyOverlay"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_help"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/why_permission" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/grant_overlay"
                android:textSize="14sp"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>

        <!-- ═══════ Language ═══════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/radioLangSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_system"
                android:textSize="16sp"
                android:textColor="#000000"
                android:paddingVertical="4dp" />

            <RadioButton
                android:id="@+id/radioLangEnglish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_english"
                android:textSize="16sp"
                android:textColor="#000000"
                android:paddingVertical="4dp" />

            <RadioButton
                android:id="@+id/radioLangRussian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_russian"
                android:textSize="16sp"
                android:textColor="#000000"
                android:paddingVertical="4dp" />
        </RadioGroup>

        <!-- ═══════ Module settings ═══════ -->
        <Button
            android:id="@+id/btnModuleSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/module_settings_title"
            android:textSize="16sp"
            android:layout_marginBottom="32dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <!-- How it works -->
        <TextView
            android:id="@+id/btnHowItWorks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/how_it_works"
            android:textSize="16sp"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- About -->
        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about"
            android:textSize="16sp"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:layout_marginBottom="32dp" />

        <!-- ═══════ Diagnostics ═══════ -->
        <!-- Last on the screen and behind its own button: chasing a bug is not
             part of setting the app up, and the switches for it should be out
             of the way until they are wanted. -->
        <Button
            android:id="@+id/btnDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/diagnostics_title"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
